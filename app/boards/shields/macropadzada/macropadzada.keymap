#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp A       &kp B       &kp C
                &kp D       &kp E       &kp F
                &kp G       &kp H       &bt BT_CLR
                &kp I       &kp J       &kp K
                &kp L       &kp M       &kp N
                &kp O       &kp P       &kp Q
            >;
            sensor-bindings = <
                &inc PG_UP PG_DN
                &inc C_VOL_DN C_VOL_UP
                &inc LEFT RIGHT
            >;
        };
    };
};